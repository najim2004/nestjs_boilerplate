# Application
APP_NAME=nestjs-boilerplate
PORT=4000
APP_URL=http://localhost:${PORT}
CLIENT_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Prisma + PostgreSQL)
DATABASE_URL="postgresql://postgres:root@localhost:5432/nestjs_boilerplate"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# BetterAuth
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:4000

# Email (SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SECURE=false

# Storage (local / s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./public/storage

# AWS S3 / MinIO (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=

# WebSocket
WS_PORT=4000
WS_CORS_ORIGIN=http://localhost:3000

# Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
